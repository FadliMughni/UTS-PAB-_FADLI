<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gray_background_042"
    tools:context=".ui.activity.ItemFormActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Top Header Bar -->
        <View
            android:id="@+id/topBarBackground042"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/navy_dark_042"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnBack042"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:src="@drawable/ic_back_042"
            app:layout_constraintBottom_toBottomOf="@+id/topBarBackground042"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/topBarBackground042"
            app:tint="@color/white_042" />

        <TextView
            android:id="@+id/tvFormHeaderTitle042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:text="Form Inventaris Barang"
            android:textColor="@color/white_042"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/topBarBackground042"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBack042"
            app:layout_constraintTop_toTopOf="@+id/topBarBackground042" />

        <!-- Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardForm042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white_042"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/card_stroke_042"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topBarBackground042">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvFormSectionTitle042"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informasi Barang"
                    android:textColor="@color/navy_dark_042"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lengkapi data barang di bawah ini (NIM: 042)"
                    android:textColor="@color/gray_text_042"
                    android:textSize="12sp" />

                <!-- Input Nama Barang -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilItemName042"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Nama Barang"
                    app:startIconDrawable="@drawable/ic_box_042"
                    app:startIconTint="@color/navy_primary_042">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etItemName042"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input Jumlah Stok -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilItemStock042"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Jumlah Stok"
                    app:startIconDrawable="@drawable/ic_category_042"
                    app:startIconTint="@color/navy_primary_042">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etItemStock042"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Input Harga Satuan -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilItemPrice042"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Harga Satuan (Rp)"
                    app:startIconDrawable="@drawable/ic_money_042"
                    app:startIconTint="@color/navy_primary_042">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etItemPrice042"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveItem042"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:text="SIMPAN DATA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/navy_primary_042"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelItem042"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Batal"
                    android:textColor="@color/gray_text_042"
                    android:textSize="15sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>