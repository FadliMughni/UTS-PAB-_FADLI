<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white_042"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke_042"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Item Icon -->
        <ImageView
            android:id="@+id/ivItemIcon042"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ic_box_042"
            android:backgroundTint="@color/navy_primary_042"
            android:contentDescription="Item Icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Item Name -->
        <TextView
            android:id="@+id/tvItemName042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/navy_dark_042"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnEdit042"
            app:layout_constraintStart_toEndOf="@+id/ivItemIcon042"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Laptop Asus ROG" />

        <!-- Stock and Price -->
        <TextView
            android:id="@+id/tvItemStockPrice042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/gray_text_042"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/btnEdit042"
            app:layout_constraintStart_toEndOf="@+id/ivItemIcon042"
            app:layout_constraintTop_toBottomOf="@+id/tvItemName042"
            tools:text="Stok: 15 | Harga: Rp 12.000.000" />

        <!-- Subtotal -->
        <TextView
            android:id="@+id/tvItemSubtotal042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/navy_primary_042"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnEdit042"
            app:layout_constraintStart_toEndOf="@+id/ivItemIcon042"
            app:layout_constraintTop_toBottomOf="@+id/tvItemStockPrice042"
            tools:text="Subtotal: Rp 180.000.000" />

        <!-- Edit Button -->
        <ImageButton
            android:id="@+id/btnEdit042"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit Item"
            android:padding="8dp"
            android:src="@drawable/ic_edit_042"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnDelete042"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/blue_highlight_042" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnDelete042"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Item"
            android:padding="8dp"
            android:src="@drawable/ic_delete_042"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/red_danger_042" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>