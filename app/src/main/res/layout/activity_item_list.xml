<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background_042"
    tools:context=".ui.activity.ItemListActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Bar -->
        <View
            android:id="@+id/topBarBackground042"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/navy_dark_042"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnBack042"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:src="@drawable/ic_back_042"
            app:layout_constraintBottom_toBottomOf="@+id/topBarBackground042"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/topBarBackground042"
            app:tint="@color/white_042" />

        <TextView
            android:id="@+id/tvHeaderTitle042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Daftar Inventaris Barang"
            android:textColor="@color/white_042"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/topBarBackground042"
            app:layout_constraintEnd_toStartOf="@+id/btnAddTop042"
            app:layout_constraintStart_toEndOf="@+id/btnBack042"
            app:layout_constraintTop_toTopOf="@+id/topBarBackground042" />

        <ImageButton
            android:id="@+id/btnAddTop042"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tambah Barang"
            android:padding="8dp"
            android:src="@drawable/ic_add_042"
            app:layout_constraintBottom_toBottomOf="@+id/topBarBackground042"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/topBarBackground042"
            app:tint="@color/white_042" />

        <!-- Search Bar Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearch042"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/white_042"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke_042"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@+id/topBarBackground042">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch042"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cari barang berdasarkan nama..."
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:startIconDrawable="@drawable/ic_search_042"
                app:startIconTint="@color/navy_primary_042">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch042"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItems042"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardSearch042"
            tools:listitem="@layout/item_inventory_042" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutEmptyState042"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardSearch042"
            tools:visibility="visible">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Empty Box"
                android:src="@drawable/ic_box_042"
                app:tint="@color/blue_accent_042" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Belum Ada Barang"
                android:textColor="@color/navy_dark_042"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Klik tombol + untuk menambahkan barang baru"
                android:textColor="@color/gray_text_042"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem042"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Tambah Barang Baru"
        android:src="@drawable/ic_add_042"
        app:backgroundTint="@color/navy_primary_042"
        app:tint="@color/white_042" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>