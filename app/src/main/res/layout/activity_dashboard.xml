<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/gray_background_042"
    tools:context=".ui.activity.DashboardActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Header Banner -->
        <View
            android:id="@+id/headerBackground042"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/navy_dark_042"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- User Greeting & Logout Button -->
        <TextView
            android:id="@+id/tvGreeting042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="12dp"
            android:textColor="@color/white_042"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnLogout042"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Selamat Datang, User!" />

        <TextView
            android:id="@+id/tvSubtitleDashboard042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:text="Ringkasan Inventaris Barang (NIM: 042)"
            android:textColor="@color/blue_light_042"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/btnLogout042"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGreeting042" />

        <ImageButton
            android:id="@+id/btnLogout042"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Logout"
            android:padding="8dp"
            android:src="@drawable/ic_logout_042"
            app:layout_constraintBottom_toBottomOf="@+id/tvSubtitleDashboard042"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvGreeting042"
            app:tint="@color/white_042" />

        <!-- Card: Total Nilai Inventaris (Main Stat Card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTotalValue042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/navy_primary_042"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitleDashboard042">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Money Icon"
                        android:src="@drawable/ic_money_042"
                        app:tint="@color/white_042" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="TOTAL NILAI INVENTARIS"
                        android:textColor="@color/blue_light_042"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalValue042"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white_042"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="Rp 0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="*Diperbarui secara real-time"
                    android:textColor="@color/blue_light_042"
                    android:textSize="11sp"
                    android:textStyle="italic" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Container for 2 stats cards -->
        <LinearLayout
            android:id="@+id/llStats042"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardTotalValue042">

            <!-- Card: Total Jenis Barang -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalTypes042"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white_042"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke_042"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Category Icon"
                        android:src="@drawable/ic_category_042"
                        app:tint="@color/navy_primary_042" />

                    <TextView
                        android:id="@+id/tvTotalTypes042"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/navy_dark_042"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Jenis Barang"
                        android:textColor="@color/gray_text_042"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Total Stok Barang -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalStock042"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white_042"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke_042"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Stock Icon"
                        android:src="@drawable/ic_box_042"
                        app:tint="@color/navy_primary_042" />

                    <TextView
                        android:id="@+id/tvTotalStock042"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/navy_dark_042"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Total Stok"
                        android:textColor="@color/gray_text_042"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Action Section Title -->
        <TextView
            android:id="@+id/tvActionTitle042"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:text="Menu Utama"
            android:textColor="@color/navy_dark_042"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llStats042" />

        <!-- Button: Daftar Barang -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewItems042"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="Kelola Daftar Barang"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/navy_primary_042"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_inventory_042"
            app:iconGravity="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvActionTitle042" />

        <!-- Button: Tambah Barang -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddItem042"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="Tambah Barang Baru"
            android:textColor="@color/navy_primary_042"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_add_042"
            app:iconGravity="textStart"
            app:iconTint="@color/navy_primary_042"
            app:strokeColor="@color/navy_primary_042"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnViewItems042" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>